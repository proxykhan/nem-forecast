# Copy to .env for local development. Never commit .env.
# In CI these come from GitHub Actions secrets; on Render, from the service's environment variables.

# local | ci | production. Production refuses to start without MLflow and Hugging Face credentials.
ENVIRONMENT=local

# Neon Postgres connection string. postgres:// and postgresql:// are both accepted and
# rewritten to the psycopg 3 driver.
DATABASE_URL=postgresql://nem_user:change-me@ep-example-000000.ap-southeast-2.aws.neon.tech/neondb?sslmode=require

# DagsHub-hosted MLflow tracking server
MLFLOW_TRACKING_URI=https://dagshub.com/your-username/nem-forecast.mlflow
MLFLOW_TRACKING_USERNAME=your-username
MLFLOW_TRACKING_PASSWORD=your-dagshub-token

# Hugging Face Hub token with write access to the model repo
HF_TOKEN=hf_your_token_here
